# ===========================================================================
# Servidor Traker — HOMELAB / PORTAINER
# Bloco de variaveis de ambiente para a stack docker-compose.homelab.yml
#
# COMO USAR
#   Portainer -> Stacks -> (sua stack) -> Environment variables -> "Advanced mode"
#   -> cole TODO o conteudo abaixo -> troque cada placeholder <...> pelo valor
#   real -> Update the stack.
#
# ESTE ARQUIVO E UM MODELO VERSIONADO NO GIT. Nao coloque nenhum valor real
# aqui. Se voce salvar uma copia preenchida em disco, salve como
# `deploy/homelab/portainer.env` e confira o .gitignore antes de commitar
# (ver README.md desta pasta).
#
# REGRA DE OURO DO PROJETO: aqui ficam apenas segredos de INFRAESTRUTURA.
# Credenciais de cliente (Pixel ID, access token da Meta, OAuth do Google) vivem
# cifradas no banco, cadastradas pelo painel admin — nunca neste bloco.
# ===========================================================================


# ###########################################################################
# 1. OBRIGATORIAS — sem estas a stack nao sobe
# ###########################################################################

# --------------------------- Banco de dados --------------------------------

# Senha do usuario `traker` do PostgreSQL.
#
# IMPORTANTE: precisa ser URL-SAFE. O compose monta a DATABASE_URL a partir
# dela (postgres://traker:SENHA@db:5432/traker), entao qualquer caractere com
# significado dentro de uma URL quebra a conexao de um jeito confuso — evite
# / @ : + # ? & % e espaco.
#
# Gere com um comando que so produz hexadecimal (seguro por construcao):
#     openssl rand -hex 16
POSTGRES_PASSWORD=<gere-com-openssl-rand-hex-16>

# --------------------------- Seguranca -------------------------------------

# Chave mestra AES-256-GCM que cifra em repouso as credenciais de anuncio
# guardadas no banco (e que tambem assina as sessoes do painel).
#
# Gere com:
#     openssl rand -hex 32
#
# ATENCAO: trocar esta chave torna ILEGIVEIS todas as credenciais ja salvas no
# banco — cada cliente teria que recadastrar tudo. Guarde uma copia em um cofre
# de senhas. Perder a chave tem o mesmo efeito que troca-la.
APP_SECRET=<gere-com-openssl-rand-hex-32>

# --------------------------- Endereco publico ------------------------------

# Dominio publico onde o servidor responde, exatamente como configurado no
# Public Hostname do Cloudflare Tunnel.
# Sem https:// na frente e sem barra no fim. Ex.: zyraflow.site
PUBLIC_HOST=<seu-dominio.com>

# --------------------------- Primeiro acesso -------------------------------

# Admin master criado automaticamente no primeiro boot da stack.
# Troque a senha pelo painel logo apos o primeiro login.
ADMIN_EMAIL=<admin@seudominio.com>
ADMIN_PASSWORD=<senha-forte-do-admin>

# --------------------------- E-mail (SMTP) ---------------------------------

# Usado para convite de usuario, redefinicao de senha e alertas operacionais.
# Provedor atual: Gmail com SENHA DE APP (nao a senha da conta). Para gerar:
#   Conta Google -> Seguranca -> Verificacao em duas etapas (precisa estar ATIVA)
#   -> Senhas de app -> criar -> copiar os 16 caracteres.
# A senha e exibida com espacos; pode colar com ou sem, o codigo remove.
#
# SEGURANCA: senha de app da acesso total a conta Google. REVOGUE qualquer uma
# que tenha aparecido em captura de tela, chat ou ticket — gerar outra leva
# 30 segundos.
SMTP_USER=<notificacoes@seudominio.com>
SMTP_PASS=<senha-de-app-de-16-caracteres>
SMTP_FROM=Servidor Traker <notificacoes@seudominio.com>

# --------------------------- Cloudflare Tunnel -----------------------------

# Token do tunel, copiado no painel da Cloudflare no momento em que o tunel e
# criado (Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Docker: o
# token e o texto longo que aparece no comando `cloudflared ... run <TOKEN>`).
#
# SEGREDO DE PRIMEIRA CLASSE: quem tem este token consegue estabelecer um tunel
# de ENTRADA para a rede do homelab. Se vazar, revogue/apague o tunel na
# Cloudflare e crie outro — mudar so a senha do banco nao adianta nada.
# 2. OPCIONAIS — ja tem default no compose
#
# Deixe comentadas. Descomente apenas a linha que voce quer mudar; o valor
# mostrado e exatamente o default que a stack usa.
# ###########################################################################

# Esquema usado ao montar URLs publicas. Atras do Cloudflare Tunnel quem
# responde ao navegador em TLS e a Cloudflare, entao https esta correto mesmo
# o Caddy interno falando HTTP puro.
# PUBLIC_SCHEME=https

# Versao da Graph API da Meta usada na Conversions API. A Meta mantem cada
# versao por cerca de 2 anos; revise periodicamente.
# META_API_VERSION=v21.0

# Nivel de log: error | warn | info | debug
# Use debug apenas para diagnosticar — ele registra o payload dos eventos, que
# contem dados pessoais (mesmo hasheados).
# LOG_LEVEL=info

# Worker de envio. Concorrencia alta demais esbarra no rate limit da Meta; o
# poll e o intervalo (ms) entre consultas a fila no Postgres (nao ha Redis).
# WORKER_CONCURRENCY=5
# WORKER_POLL_MS=1000

# Tentativas de envio de um evento (com backoff exponencial) antes de marca-lo
# como falho definitivo.
# MAX_ATTEMPTS=6

# Dias que o log de eventos fica no banco antes do expurgo pelo worker.
# Ajuste conforme a politica de privacidade acordada (LGPD).
# RETENTION_DAYS=90

# Validade (horas) da sessao de login no painel admin.
# SESSION_TTL_HOURS=12

# Cookies first-party renovados pelo servidor (mitigacao do ITP do Safari).
# 90 dias espelha a validade dos cookies _fbp/_fbc da Meta.
# COOKIE_MAX_AGE_DAYS=90
# SET_FIRST_PARTY_COOKIES=true

# SMTP: host e porta do provedor. So mude se sair do Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Validade dos links enviados por e-mail, em horas. Convite e longo (a pessoa
# pode demorar a ver o e-mail); redefinicao e curta de proposito, porque a
# janela de risco de um e-mail vazado e exatamente essa.
# CONVITE_TTL_HORAS=72
# RESET_TTL_HORAS=2


# ###########################################################################
# 3. VARIAVEIS QUE NAO ENTRAM AQUI — e por que
# ###########################################################################
#
# DATABASE_URL
#   Montada dentro do docker-compose.homelab.yml a partir de POSTGRES_PASSWORD.
#   Colocar as duas coisas aqui reintroduziria o erro classico de deploy: a
#   senha do servico `db` diverge da senha embutida na URL e a aplicacao sobe
#   sem conseguir conectar. Com uma variavel so, isso e impossivel.
#
# CADDY_SITE
#   O infra/Caddyfile.homelab tem o site literal `:80` e nao le variavel
#   nenhuma — quem decide o hostname valido e o Public Hostname do tunel, no
#   painel da Cloudflare.
#
# NODE_ENV / PORT / TRUST_PROXY
#   Fixos no compose (production / 3000 / true). Nao sao ajuste de ambiente:
#   mudar qualquer um deles quebra a stack de um jeito silencioso — TRUST_PROXY
#   false atras de proxy, por exemplo, faz todos os eventos irem para a Meta com
#   o mesmo IP e derruba o EMQ sem nenhum erro no log.
