# ===========================================================================
# Servidor Traker — MODELO de variaveis de ambiente
#
# ESTE ARQUIVO E UM MODELO E FICA VERSIONADO NO GIT.
# Nao coloque nenhum valor real aqui. Para usar:
#
#     cp .env.example .env
#     # edite o .env com os valores de verdade
#
# O .env real esta no .gitignore e no .dockerignore — ele nunca vai para o
# repositorio nem para dentro da imagem Docker. No compose, ele e injetado nos
# containers via `env_file`, entao as variaveis chegam como ambiente de processo
# (o src/config/env.js da precedencia ao ambiente sobre o arquivo).
#
# REGRA DE OURO DO PROJETO: aqui ficam apenas segredos de INFRAESTRUTURA.
# Credenciais de cliente (Pixel ID, access token da Meta, OAuth do Google) vivem
# cifradas no banco, cadastradas pelo painel admin — nunca neste arquivo.
# ===========================================================================

# --------------------------- Aplicacao -------------------------------------

# Ambiente de execucao: development | production
# Em production a aplicacao exige APP_SECRET definido e deixa de expor stack
# traces nas respostas de erro.
NODE_ENV=production

# Porta HTTP interna que o Express escuta dentro do container.
# Nao precisa mudar: quem publica portas para a internet e o Caddy (80/443).
PORT=3000

# --------------------------- Banco de dados --------------------------------

# String de conexao do PostgreSQL.
# O host `db` e o nome do servico no docker-compose — a resolucao DNS acontece
# na rede interna do compose. Rodando a aplicacao fora do Docker, troque por
# localhost:5432.
# A senha abaixo precisa ser IGUAL a POSTGRES_PASSWORD.
DATABASE_URL=postgres://traker:TROQUE_ESTA_SENHA@db:5432/traker

# Senha do usuario `traker` do PostgreSQL. E usada tanto para inicializar o
# banco (servico db) quanto para a aplicacao conectar (via DATABASE_URL).
# Gere uma senha longa e aleatoria, por exemplo:
#     openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# --------------------------- Seguranca -------------------------------------

# Chave mestra que cifra em repouso (AES-256-GCM) as credenciais dos clientes
# guardadas no banco, e que tambem assina as sessoes do painel.
#
# Gere com:
#     openssl rand -hex 32
#
# ATENCAO: se esta chave for perdida, TODOS os access tokens salvos no banco
# tornam-se irrecuperaveis e cada cliente tera que recadastrar as credenciais.
# Guarde uma copia em um cofre de senhas. Trocar a chave exige recifrar os
# dados existentes — nao e uma alteracao inofensiva.
APP_SECRET=cole-aqui-o-resultado-de-openssl-rand-hex-32

# Chave ANTERIOR, usada apenas durante uma rotacao de APP_SECRET.
# Enquanto ela estiver definida, credenciais cifradas com a chave antiga continuam
# legiveis e tudo que for regravado ja sai com a chave nova — a troca acontece sem
# downtime. Remova esta linha depois que todas as credenciais forem regravadas.
# Procedimento completo em docs/06-operacao-runbook.md.
# APP_SECRET_PREVIOUS=

# --------------------------- Endereco publico ------------------------------

# Dominio publico onde o servidor responde. Usado para montar os snippets e as
# URLs mostradas no painel, e lido pelo Caddy para saber para qual dominio
# emitir o certificado principal.
# Producao: traker.codigovencedor.com
PUBLIC_HOST=traker.codigovencedor.com

# Esquema usado ao montar URLs publicas (https em producao, http em dev local).
PUBLIC_SCHEME=https

# Confiar nos cabecalhos X-Forwarded-* enviados pelo proxy reverso.
# DEVE ser true sempre que houver Caddy/nginx na frente (o caso do compose).
# Se ficar false atras do proxy, o client_ip_address enviado a Conversions API
# vira o IP do container do proxy, igual para todos os eventos, e a qualidade
# de correspondencia (EMQ) da Meta despenca sem nenhum erro visivel.
# So deixe false se a aplicacao for exposta diretamente, sem proxy.
TRUST_PROXY=true

# --------------------------- Integracoes -----------------------------------

# Versao da Graph API da Meta usada nas chamadas da Conversions API.
# A Meta mantem cada versao por cerca de 2 anos; revise periodicamente.
META_API_VERSION=v21.0

# Versao da Google Ads API usada na rota google_ads (UploadClickConversions).
# O Google descontinua versoes periodicamente; atualize sem mexer no codigo.
GOOGLE_ADS_API_VERSION=v17

# DDI acrescentado automaticamente a telefones de 10-11 digitos (numero nacional
# sem codigo de pais) antes do hash SHA-256 exigido pela Meta. E um erro comum de
# dataLayer enviar "11987654321" em vez de "5511987654321", e sem o DDI o telefone
# simplesmente nao casa. Deixe vazio para nunca acrescentar nada (operacao fora do Brasil).
DEFAULT_COUNTRY_CODE=55

# --------------------------- Privacidade / LGPD ----------------------------

# Como tratar um evento que chega SEM consent_state.
#   false (padrao) -> o evento segue com a PII. Necessario enquanto o site ainda
#                     nao envia o estado de consentimento, senao o tracking para
#                     de funcionar silenciosamente.
#   true           -> ausencia de sinal e tratada como negacao: a PII e removida
#                     antes de gravar e de enviar. Postura mais defensavel sob
#                     LGPD/GDPR — ligue assim que o site tiver um CMP configurado.
STRICT_CONSENT=false

# --------------------------- E-mail (SMTP) ---------------------------------

# Usado para convite de usuario, redefinicao de senha e alertas operacionais.
# Provedor atual: Gmail com SENHA DE APP (nao a senha da conta). Para gerar:
#   Conta Google -> Seguranca -> Verificacao em duas etapas (precisa estar ATIVA)
#   -> Senhas de app -> criar -> copiar os 16 caracteres.
# A senha e exibida com espacos; pode colar com ou sem, o codigo remove.
#
# Limite do Gmail: ~500 mensagens/dia. Suficiente para convites e alertas, mas nao
# para envio em massa. Para trocar por Resend/SES/Postmark, so mudar estas variaveis —
# nenhuma outra parte do codigo conhece o provedor.
#
# SEGURANCA: senha de app da acesso total a conta Google. Trate como segredo de
# producao, e REVOGUE imediatamente qualquer senha de app que tenha sido exibida em
# captura de tela, chat ou ticket — gerar outra leva 30 segundos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=notificacoes@seudominio.com
SMTP_PASS=senha-de-app-de-16-caracteres
SMTP_FROM="Servidor Traker <notificacoes@seudominio.com>"

# Validade dos links enviados por e-mail, em horas.
# Convite e longo (a pessoa pode demorar a ver); redefinicao e curta de proposito,
# porque a janela de risco de um e-mail vazado e exatamente essa.
CONVITE_TTL_HORAS=72
RESET_TTL_HORAS=2

# --------------------------- Observabilidade -------------------------------

# Nivel de log: error | warn | info | debug
# Use debug apenas para diagnosticar — ele registra o payload dos eventos, que
# contem dados pessoais (mesmo hasheados).
LOG_LEVEL=info

# --------------------------- Worker de envio -------------------------------

# Quantos jobs da fila o worker processa em paralelo.
# Subir demais pode esbarrar no rate limit da Meta; 5 e um ponto de partida
# conservador para uma instancia pequena da OCI.
WORKER_CONCURRENCY=5

# Intervalo (ms) entre consultas do worker a fila no Postgres.
# Como nao usamos Redis, a fila e uma tabela e o worker faz polling. Valores
# menores reduzem a latencia de envio, mas aumentam a carga no banco.
WORKER_POLL_MS=1000

# Numero maximo de tentativas de envio de um evento antes de marca-lo como
# falho definitivo. As tentativas usam backoff exponencial, entao 6 cobre
# varias horas de indisponibilidade do endpoint de destino.
MAX_ATTEMPTS=6

# --------------------------- Retencao de dados -----------------------------

# Por quantos dias o log de eventos fica no banco antes de ser expurgado pelo
# worker. Ajuste conforme a politica de privacidade acordada com os clientes
# (LGPD: guardar dado pessoal so pelo tempo necessario).
RETENTION_DAYS=90

# --------------------------- Sessao e cookies ------------------------------

# Validade (horas) da sessao de login no painel admin.
SESSION_TTL_HOURS=12

# Validade (dias) dos cookies first-party que o servidor renova.
# 90 dias espelha a validade dos cookies _fbp/_fbc da Meta.
COOKIE_MAX_AGE_DAYS=90

# Renovar cookies first-party pelo servidor (mitigacao do ITP do Safari, que
# limita a 7 dias os cookies gravados por JavaScript). Deixe true a menos que
# haja restricao legal especifica no projeto do cliente.
SET_FIRST_PARTY_COOKIES=true

# --------------------------- Primeiro acesso -------------------------------

# Credenciais do usuario administrador criado por `npm run seed` /
# `npm run criar-usuario` no primeiro deploy.
# Troque a senha pelo painel logo apos o primeiro login e, de preferencia,
# remova estas duas linhas do .env depois que a conta existir.
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_PASSWORD=troque-esta-senha-no-primeiro-login
